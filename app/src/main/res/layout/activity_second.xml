<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView android:id="@+id/textView2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:padding="24dp" android:text="@string/hello" android:textSize="48sp" />
    <TextView android:id="@+id/textView3" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="@string/count_initial" android:textSize="96sp" />
    <Button android:id="@+id/button5" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/go_activity_1"
        android:onClick="goToMainActivity" />
</LinearLayout>
