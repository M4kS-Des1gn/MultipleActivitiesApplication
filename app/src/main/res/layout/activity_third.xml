<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView android:id="@+id/textView4" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:padding="24dp" android:text="@string/activity_3" android:textSize="48sp" />
    <FrameLayout android:id="@+id/swipeArea" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:contentDescription="@string/swipe_hint" android:clickable="true" android:focusable="true">
        <TextView android:id="@+id/textView5" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:text="@string/count_initial" android:textSize="96sp" />
    </FrameLayout>
    <Button android:id="@+id/button6" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/go_activity_2"
        android:onClick="goToSecondActivity" />
    <Button android:id="@+id/button4" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/go_activity_1"
        android:onClick="goToMainActivity" />
</LinearLayout>
