<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <Button android:id="@+id/button2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/go_activity_2"
        android:onClick="goToSecondActivity" />
    <Button android:id="@+id/button3" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/go_activity_3"
        android:onClick="goToThirdActivity" />
    <TextView android:id="@+id/showCount" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="@string/count_initial" android:textSize="96sp" />
    <Button android:id="@+id/buttonCount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/count"
        android:onClick="countUp" />
</LinearLayout>
